{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    //"display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    //"cursor",
    "terminal",
    //"terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    //"localip",
    //"battery",
    "poweradapter",
    //"locale",
    "break",
    "colors"
  ],
  "logo": {
    "color": {
      "1": "green",
      "2": "magenta"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": ": ",
    "color": {
        "keys": "magenta",
        "title": "magenta"
    },
    "key": {
        "width": 12,
        "type": "string"
    },
    "bar": {
        "width": 10
    },
    "percent": {
        "type": 9,
        "color": {
            "green": "green",
            "yellow": "light_yellow",
            "red": "light_red"
        }
    }
  }
}
